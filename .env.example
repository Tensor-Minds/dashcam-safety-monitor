# Host ports exposed by Docker Compose
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Public backend endpoints embedded into the Next.js frontend during image build.
# Keep these empty for local HTTP deployment; the browser will use the current
# hostname with BACKEND_PORT 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/video

# Remote HTTPS deployment example:
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws/video
