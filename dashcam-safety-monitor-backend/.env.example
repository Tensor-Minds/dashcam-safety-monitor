# Dashcam Safety Monitor Backend Environment Variables Template

# 1. YOLO Model Inference Confidence Thresholds
CONF_ROAD_SIGN=0.5
CONF_POTHOLE=0.5
CONF_ANOMALY=0.5
CONF_LANE_LINE=0.5
DEFAULT_MODEL_CONFIDENCE=0.5

# 2. Post-Inference Detection Filter Confidence Thresholds
DET_CONF_ROAD_SIGN=0.5
DET_CONF_POTHOLE=0.5
DET_CONF_ANOMALY=0.5
DET_CONF_LANE_LINE=0.5
DEFAULT_DETECTION_CONFIDENCE=0.5

# Report-aligned image quality suppression (variance of Laplacian)
IMAGE_QUALITY_BLUR_THRESHOLD=80

# Optional alternative rule configuration file
# ALERT_RULES_PATH=/absolute/path/to/rules.yml
